{
  "name": "@onigam/lab-kit",
  "version": "0.1.3",
  "description": "Shared shell of the interactive 3D energy labs: 3D stage, application frame, panels, SVG drawings, FR/EN strings and small physics helpers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onigam/lab-kit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./drawings": {
      "types": "./dist/drawings/index.d.ts",
      "default": "./dist/drawings/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./sim": {
      "types": "./dist/sim/index.d.ts",
      "default": "./dist/sim/index.js"
    },
    "./sim/*": {
      "types": "./dist/sim/*.d.ts",
      "default": "./dist/sim/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/*.mjs\"",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  }
}
